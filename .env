# shellcheck disable=SC2034

################################################################################
## Base settings
################################################################################

SALTBOX_MODULE_METRIC_ON=true

METRIC_BACKEND_PATH='/api/metric'
METRIC_BUILD_DIR='../saltbox-metric-backend'  #NOTE: For dev-override only
METRIC_DOCKER_CONTAINERS_PATH='/var/lib/docker/containers/'
METRIC_DOCKER_SOCKET='/var/run/docker.sock'
METRIC_CONTAINERD_SOCKET='/run/containerd/containerd.sock'
METRIC_SYSFS_PATH='/sys'
METRIC_IMAGE_TAG='master'
METRIC_OBSERVABILITY_IMAGE_TAG='master'
GRAFANA_IMAGE_TAG='master'
#NOTE: Absolute or relative to saltbox-compose.
METRIC_OUTER_PATH='../saltbox-metric-compose/'


################################################################################
## Discovery settings
################################################################################

METRIC_SERVICE_NAME='metric'
METRIC_SERVICE_TITLE='SaltBox Metric Service'
METRIC_SERVICE_DESCRIPTION='Metric service of SaltBox project.'
METRIC_SERVICE_VENDOR='Salt.Box'
METRIC_SERVICE_TYPE='official'
METRIC_INSTANCE_ID='8bdb91c4889840a8a2e29193136ed711'
METRIC_HOST='saltbox-metric'
METRIC_PORT=8000
METRIC_FRONT_CONTAINER_NAME='saltbox-metric-frontend'
METRIC_FRONT_CONTAINER_PORT=80


################################################################################
## Alerting settings
################################################################################

SMTP_HOST='smtp.<CHANGE_ME>.com:465'
SMTP_USER='smtp_user@example.com'
SMTP_FROM_ADDRESS='smtp_user@example.com'
SMTP_ALERT_EMAILS='me@example.com;you@example.co'
