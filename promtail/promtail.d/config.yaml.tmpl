clients:
  - url: http://grafana-loki:3100/loki/api/v1/push

positions:
  filename: "/tmp/positions.yaml"
  sync_period: 30s

scrape_configs:

  - job_name: audit_logs
    static_configs:
      #NOTE: Inherited parameter from Prometheus. Is not used
      - targets: [__stub__]
        labels:
          service: audit-events
          job: audit-events
          __path__: '${PROMTAIL_AUDIT_LOGS_STORAGE_PATH}*.jsonl'
    pipeline_stages:
      - json:
          expressions:
            category: category
            action: action
            status: status
            resource_type: resource_type
            source_service: source_service
            subject_type: subject_type
      - labels:
          category:
          action:
          status:
          resource_type:
          source_service:
          subject_type:

  - job_name: docker_logs
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 10s

    relabel_configs:
      - source_labels: ['__meta_docker_container_name']
        #NOTE: e.g, replacement of the name container form 'saltbox-mongo-1' to 'mongo'
        regex: '/saltbox-(.+)-1'
        replacement: '$1'
        target_label: 'service'

      - source_labels: ['__meta_docker_container_name']
        regex: '/saltbox-saltbox-(.+)-1'
        replacement: '$1'
        target_label: 'service'

    pipeline_stages:
      - match:
          selector: '{service="rabbitmq"}'
          stages:
            - json:
                expressions:
                  log: log
            - regex:
                expression: ${RABBITMQ_REGEX_EXPRESSION}
            - timestamp:
                source: timestamp
                #NOTE: RFC1123: Mon, 02 Jan 2006 15:04:05 MST
                format: RFC1123
            - labels:
                detected_level: level
                pid:
            - output:
                source: message

      - match:
          selector: '{service="mongo"}'
          stages:
            - json:
                expressions:
                  log: log
            - regex:
                expression: ${MONGO_REGEX_EXPRESSION}
            - timestamp:
                source: timestamp
                format: RFC1123
            - labels:
                message:
                severity:
                category:
                id:
                context:
            - output:
                source: log

      - match:
          selector: '{service="saltbox-metric-app"}'
          stages:
            - json:
                expressions:
                  log: log
            - regex:
                expression: ${METRIC_REGEX_EXPRESSION}
            - timestamp:
                source: timestamp
                format: RFC1123
            - labels:
                detected_level: level
                module:
                agent:
            - output:
                source: message

  - job_name: system_logs
    static_configs:
      - targets:
        - 'localhost'
        labels:
          job: var_logs
          __path__: /var/log/*.log
